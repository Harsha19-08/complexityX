# ComplexityX works with no configuration: without a provider it uses the offline rule-based engine.
# Add a provider for AI analysis and optimized code. Any OpenAI-compatible endpoint works.

# openrouter | groq | gemini | together | ollama | custom
AI_PROVIDER=openrouter
AI_API_KEY=
# Optional: override the preset's model and base URL
AI_MODEL=
AI_BASE_URL=
# Set to false if your model does not support response_format=json_object
AI_JSON_MODE=true
AI_TIMEOUT_MS=60000
AI_TEMPERATURE=0.2

# Allow visitors to supply their own key from Settings (stored in their browser only)
ALLOW_CLIENT_KEYS=true
RATE_LIMIT_PER_MINUTE=20

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_URL=https://github.com
